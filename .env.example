# Host ports used by docker-compose.yml
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Database name inside the MongoDB container (the URI is set in docker-compose.yml)
MONGODB_DATABASE=project_handover

# Frontend origin allowed by backend CORS. Must match http://localhost:FRONTEND_PORT
CORS_ORIGINS=http://localhost:8080

# Backend URL the browser calls. Baked into the frontend at build time.
VITE_API_BASE_URL=http://localhost:8000
