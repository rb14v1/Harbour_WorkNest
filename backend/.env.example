# MongoDB connection string. Use a local instance or an Atlas URI with placeholder credentials.
MONGODB_URI=mongodb://localhost:27017
# Development database name.
MONGODB_DATABASE=project_handover
# Dedicated test database. Name must end in _test and must differ from MONGODB_DATABASE.
MONGODB_TEST_DATABASE=project_handover_test
# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
